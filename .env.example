# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real .env file.

# --- Neo4j connection ---
# Local Neo4j Desktop / Server:  neo4j://localhost:7687   (or bolt://localhost:7687)
# Neo4j Aura:                    neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5

# --- Application ---
# development | production   (database reset is refused in production)
APP_ENV=development
LOG_LEVEL=INFO
# auto = use Neo4j Graph Data Science if installed, otherwise NetworkX; or force: gds | networkx
ANALYTICS_ENGINE=auto
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be "true" before the integration tests may wipe and reseed the project data
ACN_ALLOW_RESET=false
